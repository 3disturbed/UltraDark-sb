<Project Sdk="Microsoft.NET.Sdk">

  <!-- The build CLI (sbengine): one line of Main over the engine's export pipeline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sbengine</AssemblyName>
    <RootNamespace>SexyBiscuit.Build</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SexyBiscuit.Engine\SexyBiscuit.Engine.csproj" />
  </ItemGroup>

</Project>
