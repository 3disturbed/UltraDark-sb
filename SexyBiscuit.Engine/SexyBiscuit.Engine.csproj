<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 alone unless a build asks for Android, so nobody needs the `android`
         workload installed to build the engine, run the tests or open the editor.
         The build CLI passes -p:SexyBiscuitAndroid=true when it wants the APK head. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(SexyBiscuitAndroid)' == 'true'">net8.0;net10.0-android</TargetFrameworks>
    <!-- Restoring both frameworks at once makes NuGet notice that the net8.0 pin of
         System.Text.Json is redundant under .NET 10's package pruning. The pin is still
         wanted for the net8.0 build, and the desktop-only restore stays clean, so the
         notice is silenced for the two-framework restore rather than acted on. -->
    <NoWarn Condition="'$(SexyBiscuitAndroid)' == 'true'">$(NoWarn);NU1510</NoWarn>
    <!-- SYSLIB0060: SaveManager still uses the Rfc2898DeriveBytes constructor, which net10
         marks obsolete and net8 does not. Moving to the static Pbkdf2 is a change to save
         encryption and belongs in its own commit, not in the Android port. -->
    <NoWarn Condition="$(TargetFramework.Contains('-android'))">$(NoWarn);SYSLIB0060</NoWarn>
    <!-- The Android side is net10.0, not net8.0: the installed android workload is the
         .NET 10 one, and asking it for net8.0-android packs gets an end-of-life error and
         a compile SDK that falls back to API 21. The desktop side stays on net8.0, so the
         engine compiles against two BCLs — anything newer than net8.0 used in engine code
         breaks the desktop build first, which is the safer direction for that to fail. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SexyBiscuit.Engine</RootNamespace>
    <AssemblyName>SexyBiscuit.Engine</AssemblyName>
    <Configurations>Debug;Release;Development</Configurations>

    <!-- Ship the XML doc file so IntelliSense shows the engine's documentation in
         consuming projects. CS1591 (missing XML comment on a public member) is not
         treated as a warning: much of the engine's surface is self-describing
         properties, and failing the build over them would drown the warnings that
         matter. Malformed XML and broken crefs still warn. -->
    <!-- The one place the engine version is stated. EngineInfo.Version reads it back
         off the assembly, and html5/src/core/EngineInfo.js is pinned equal to it by
         html5/tests/graphics.test.js. Without this the assembly carried MSBuild's
         default and four unrelated sources agreed on 1.0.0 by accident. -->
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG;SEXY_DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Development'">
    <DefineConstants>$(DefineConstants);DEVELOPMENT;SEXY_DEV</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Steam is desktop-only, and every Steam/*.cs file is already wholly behind this
       define, so not setting it on Android removes the integration with no code change. -->
  <PropertyGroup Condition="!$(TargetFramework.Contains('-android'))">
    <DefineConstants>$(DefineConstants);STEAMWORKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project exercises internal lifecycle hooks (Time.Advance, GameInstance
         initialisation) that gameplay code has no business calling. -->
    <InternalsVisibleTo Include="SexyBiscuit.Tests" />
  </ItemGroup>

  <!-- Desktop-only packages. Each ships native code with no Android build:
       MonoGame's desktop backend is SDL, AssimpNet is native libassimp, Steamworks.NET
       is a desktop SDK, and NAudio is Windows-first. The engine code that touches the
       last three is behind #if ANDROID / #if STEAMWORKS. -->
  <ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="Steamworks.NET" Version="20.1.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Pinned for net8.0. On net10.0-android it is in the shared framework, and naming
         it there is an NU1510 "will not be pruned" error. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- The same MonoGame version, so there is no API drift between the two builds. -->
  <!-- The Android SDK adds its own implicit usings, and Android.App.GameMode and
       Android.Widget.Button then collide with the engine's own GameMode and Button in
       every file. Dropping the two namespaces is far less invasive than renaming engine
       types or qualifying hundreds of call sites; code that genuinely needs them (the
       generated Activity) says using Android.App itself. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <!-- With STEAMWORKS undefined every method body in Steam/ compiles away, leaving
         declared-but-unused events and a wall of CS0067. The integration is desktop-only,
         so the files simply are not part of the Android build. -->
    <Compile Remove="Steam/**/*.cs" />
    <!-- Loads a game's compiled C# through AssemblyDependencyResolver, which the platform
         analyser correctly says is unsupported on Android. Nothing else in the engine
         references it, and an Android game's logic is JavaScript, so it is left out
         rather than stubbed. -->
    <Compile Remove="Code/GameAssemblyLoader.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.1.303" />
    <!-- Ogg decoding. On desktop this arrives transitively through the packages above;
         it is pure managed C#, so naming it directly is all Android needs — and .ogg is
         what every bundled template ships. -->
    <PackageReference Include="NVorbis" Version="0.10.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScript scripting -->
    <PackageReference Include="Jint" Version="3.1.1" />

    <!-- 2D Physics -->
    <PackageReference Include="Aether.Physics2D" Version="2.1.0" />

    <!-- 3D Physics -->
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="BepuUtilities" Version="2.4.0" />

    <!-- Networking -->
    <PackageReference Include="LiteNetLib" Version="1.1.0" />

    <!-- Font loading (runtime TTF/OTF, no pre-baking) -->
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.3" />

  </ItemGroup>

  <!-- One font, two engines. The browser imports this file directly; embedding
       the same path here is what makes it impossible for the two to draw
       different text. -->
  <ItemGroup>
    <EmbeddedResource Include="../html5/src/ui/font5x7.json" LogicalName="SexyBiscuit.Engine.font5x7.json" />
    <EmbeddedResource Include="../html5/src/rendering/graphics-presets.json" LogicalName="SexyBiscuit.Engine.graphics-presets.json" />
    <EmbeddedResource Include="../html5/src/ui/graphics-menu.json" LogicalName="SexyBiscuit.Engine.graphics-menu.json" />
    <EmbeddedResource Include="../html5/src/rendering/sky-gradient.json" LogicalName="SexyBiscuit.Engine.sky-gradient.json" />
  </ItemGroup>

  <!-- MakeChibi's parts and clips, for the same reason: one table, so a recipe cannot
       describe a different character on each engine. -->
  <ItemGroup>
    <EmbeddedResource Include="../html5/src/chibi/chibi-parts.json" LogicalName="SexyBiscuit.Engine.chibi-parts.json" />
    <EmbeddedResource Include="../html5/src/chibi/chibi-clips.json" LogicalName="SexyBiscuit.Engine.chibi-clips.json" />
  </ItemGroup>

</Project>
