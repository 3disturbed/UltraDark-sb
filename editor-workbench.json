{
  "version": 1,
  "title": "SexyBiscuit Editor Workbench Contract",
  "layout": {
    "regions": ["menu", "modes", "viewport", "outliner", "details", "content", "output", "status"],
    "desktop": "dockable",
    "tablet": "adaptive-stage"
  },
  "commands": {
    "editor.transform.translate": { "shortcut": "W", "label": "Move" },
    "editor.transform.rotate": { "shortcut": "E", "label": "Rotate" },
    "editor.transform.scale": { "shortcut": "R", "label": "Scale" },
    "editor.focus": { "shortcut": "F", "label": "Focus Selection" },
    "editor.undo": { "shortcut": "CtrlOrMeta+Z", "label": "Undo" },
    "editor.redo": { "shortcut": "CtrlOrMeta+Y", "label": "Redo" },
    "editor.duplicate": { "shortcut": "CtrlOrMeta+D", "label": "Duplicate" },
    "editor.delete": { "shortcut": "Delete", "label": "Delete" }
  },
  "transform": {
    "modes": ["translate", "rotate", "scale"],
    "spaces": ["world", "local"],
    "snapping": ["translate", "rotate", "scale"]
  },
  "componentStatus": ["editable", "read-only-with-reason", "tracked-missing"]
}
