{
  "version": 1,
  "title": "SexyBiscuit Editor Workbench Contract",
  "layout": {
    "regions": ["menu", "modes", "viewport", "outliner", "details", "content", "output", "status"],
    "desktop": "dockable",
    "tablet": "adaptive-stage"
  },
  "commands": {
    "editor.transform.translate": { "shortcut": "W", "label": "Move" },
    "editor.transform.rotate": { "shortcut": "E", "label": "Rotate" },
    "editor.transform.scale": { "shortcut": "R", "label": "Scale" },
    "editor.focus": { "shortcut": "F", "label": "Focus Selection" },
    "editor.undo": { "shortcut": "CtrlOrMeta+Z", "label": "Undo" },
    "editor.redo": { "shortcut": "CtrlOrMeta+Y", "label": "Redo" },
    "editor.duplicate": { "shortcut": "CtrlOrMeta+D", "label": "Duplicate" },
    "editor.delete": { "shortcut": "Delete", "label": "Delete" }
  },
  "transform": {
    "modes": ["translate", "rotate", "scale"],
    "spaces": ["world", "local"],
    "snapping": ["translate", "rotate", "scale"]
  },
  "selection": {
    "ordered": true,
    "primary": "last",
    "multiSelect": ["toggle", "range"],
    "hierarchyOperationPolicy": "selected-roots"
  },
  "componentStatus": ["editable", "read-only-with-reason", "tracked-missing"],
  "propertyTypeCoverage": {
    "number": { "native": "editable", "browser": "editable" },
    "int": { "native": "editable", "browser": "editable" },
    "bool": { "native": "editable", "browser": "editable" },
    "string": { "native": "editable", "browser": "editable" },
    "vector2": { "native": "editable", "browser": "editable" },
    "vector3": { "native": "editable", "browser": "editable" },
    "vector4": { "native": "editable", "browser": "editable" },
    "quaternion": { "native": "editable", "browser": "editable" },
    "color": { "native": "editable", "browser": "editable" },
    "enum": { "native": "editable", "browser": "editable" },
    "asset": { "native": "editable", "browser": "editable" },
    "material": { "native": "read-only-with-reason", "browser": "read-only-with-reason" },
    "list": { "native": "read-only-with-reason", "browser": "editable" }
  }
}
