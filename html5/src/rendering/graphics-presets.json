{
  "$comment": "The quality presets, read by BOTH engines at runtime and by both test suites: SexyBiscuit.Tests/GraphicsPresetTests.cs and html5/tests/graphics.test.js. Presets live in data rather than in two switch statements because 'Battery' has to mean the same numbers on a laptop running the native build and on the same laptop running the web build -- and a constant that drifted between the engines would make the same game feel like two different games with no test able to see it. Every preset states every shared field; the native and web blocks carry the knobs only one platform has. The benchmark thresholds map a measured frame rate back onto a preset, which is what the first-run probe and the Benchmark tab both use.",
  "version": 1,
  "default": "medium",
  "presets": [
    {
      "id": "battery",
      "name": "Battery Saver",
      "summary": "Longest battery life. Everything optional is off and the frame rate is capped low.",
      "shared": {
        "renderScale": 0.5,
        "vsync": true,
        "frameCap": 30,
        "shadows": "Off",
        "shadowDistance": 20,
        "maxLightsPerObject": 1,
        "tessellationRadial": 8,
        "tessellationRings": 4,
        "drawDistance": 200,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": false,
        "skybox": false,
        "particleDensity": 0.15,
        "postProcessing": false,
        "bloom": false,
        "vignette": false,
        "colourGrade": false,
        "scanline": false,
        "lighting2D": "Off",
        "textureFiltering": "Point",
        "anisotropy": 1,
        "streamingRadius": 1,
        "maxLoadsPerFrame": 1
      },
      "native": { "msaa": 1, "shadowMapSize": 256 },
      "web": {
        "maxPixelRatio": 1,
        "highDpi": false,
        "antialias": false,
        "powerPreference": "low-power",
        "shaderPrecision": "mediump",
        "throttleWhenHidden": true
      }
    },
    {
      "id": "low",
      "name": "Low",
      "summary": "For old laptops and phones. Playable everywhere.",
      "shared": {
        "renderScale": 0.75,
        "vsync": true,
        "frameCap": 60,
        "shadows": "Off",
        "shadowDistance": 30,
        "maxLightsPerObject": 2,
        "tessellationRadial": 12,
        "tessellationRings": 8,
        "drawDistance": 400,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": true,
        "skybox": true,
        "particleDensity": 0.4,
        "postProcessing": false,
        "bloom": false,
        "vignette": false,
        "colourGrade": false,
        "scanline": false,
        "lighting2D": "Low",
        "textureFiltering": "Bilinear",
        "anisotropy": 1,
        "streamingRadius": 1,
        "maxLoadsPerFrame": 1
      },
      "native": { "msaa": 1, "shadowMapSize": 512 },
      "web": {
        "maxPixelRatio": 1,
        "highDpi": false,
        "antialias": false,
        "powerPreference": "default",
        "shaderPrecision": "mediump",
        "throttleWhenHidden": true
      }
    },
    {
      "id": "medium",
      "name": "Medium",
      "summary": "The default. What a mid-range machine from the last five years runs comfortably.",
      "shared": {
        "renderScale": 1,
        "vsync": true,
        "frameCap": 60,
        "shadows": "Low",
        "shadowDistance": 50,
        "maxLightsPerObject": 4,
        "tessellationRadial": 24,
        "tessellationRings": 16,
        "drawDistance": 1000,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": true,
        "skybox": true,
        "particleDensity": 1,
        "postProcessing": true,
        "bloom": true,
        "vignette": false,
        "colourGrade": true,
        "scanline": false,
        "lighting2D": "Medium",
        "textureFiltering": "Trilinear",
        "anisotropy": 4,
        "streamingRadius": 2,
        "maxLoadsPerFrame": 1
      },
      "native": { "msaa": 2, "shadowMapSize": 1024 },
      "web": {
        "maxPixelRatio": 2,
        "highDpi": true,
        "antialias": true,
        "powerPreference": "high-performance",
        "shaderPrecision": "highp",
        "throttleWhenHidden": true
      }
    },
    {
      "id": "high",
      "name": "High",
      "summary": "A dedicated GPU. Shadows, post-processing and full-density particles.",
      "shared": {
        "renderScale": 1,
        "vsync": true,
        "frameCap": 0,
        "shadows": "High",
        "shadowDistance": 80,
        "maxLightsPerObject": 4,
        "tessellationRadial": 32,
        "tessellationRings": 24,
        "drawDistance": 2000,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": true,
        "skybox": true,
        "particleDensity": 1,
        "postProcessing": true,
        "bloom": true,
        "vignette": true,
        "colourGrade": true,
        "scanline": false,
        "lighting2D": "High",
        "textureFiltering": "Anisotropic",
        "anisotropy": 8,
        "streamingRadius": 3,
        "maxLoadsPerFrame": 2
      },
      "native": { "msaa": 4, "shadowMapSize": 2048 },
      "web": {
        "maxPixelRatio": 2,
        "highDpi": true,
        "antialias": true,
        "powerPreference": "high-performance",
        "shaderPrecision": "highp",
        "throttleWhenHidden": true
      }
    },
    {
      "id": "ultra",
      "name": "Ultra",
      "summary": "Everything on, at native resolution, with no frame cap.",
      "shared": {
        "renderScale": 1,
        "vsync": false,
        "frameCap": 0,
        "shadows": "Ultra",
        "shadowDistance": 120,
        "maxLightsPerObject": 4,
        "tessellationRadial": 48,
        "tessellationRings": 32,
        "drawDistance": 4000,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": true,
        "skybox": true,
        "particleDensity": 1,
        "postProcessing": true,
        "bloom": true,
        "vignette": true,
        "colourGrade": true,
        "scanline": false,
        "lighting2D": "High",
        "textureFiltering": "Anisotropic",
        "anisotropy": 16,
        "streamingRadius": 4,
        "maxLoadsPerFrame": 4
      },
      "native": { "msaa": 8, "shadowMapSize": 4096 },
      "web": {
        "maxPixelRatio": 3,
        "highDpi": true,
        "antialias": true,
        "powerPreference": "high-performance",
        "shaderPrecision": "highp",
        "throttleWhenHidden": false
      }
    },
    {
      "id": "benchmark",
      "name": "Benchmark",
      "summary": "Ultra with vsync and the frame cap removed, so the number measured is the hardware and not the display.",
      "shared": {
        "renderScale": 1,
        "vsync": false,
        "frameCap": 0,
        "shadows": "Ultra",
        "shadowDistance": 200,
        "maxLightsPerObject": 4,
        "tessellationRadial": 64,
        "tessellationRings": 48,
        "drawDistance": 8000,
        "frustumCulling": true,
        "sortOpaqueFrontToBack": true,
        "skybox": true,
        "particleDensity": 1,
        "postProcessing": true,
        "bloom": true,
        "vignette": true,
        "colourGrade": true,
        "scanline": false,
        "lighting2D": "High",
        "textureFiltering": "Anisotropic",
        "anisotropy": 16,
        "streamingRadius": 4,
        "maxLoadsPerFrame": 8
      },
      "native": { "msaa": 8, "shadowMapSize": 4096 },
      "web": {
        "maxPixelRatio": 3,
        "highDpi": true,
        "antialias": true,
        "powerPreference": "high-performance",
        "shaderPrecision": "highp",
        "throttleWhenHidden": false
      }
    }
  ],
  "$thresholdComment": "A measured average frame rate maps onto the highest preset whose minFps it clears. Read top-down; the first match wins, so the order here is load-bearing.",
  "thresholds": [
    { "preset": "ultra",   "minFps": 110 },
    { "preset": "high",    "minFps": 75 },
    { "preset": "medium",  "minFps": 45 },
    { "preset": "low",     "minFps": 25 },
    { "preset": "battery", "minFps": 0 }
  ]
}
