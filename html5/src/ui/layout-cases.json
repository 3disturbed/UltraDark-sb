    {
      "name": "stretching between two different anchors fills the span",
      "why": "The widget tree this replaces declared AnchorMax and then ignored it, so nothing could ever stretch without a second manual pass.",
      "viewport": [
        800,
        600
      ],
      "tree": {
        "name": "root",
        "children": [
          {
            "name": "band",
            "absolute": true,
            "anchorMin": [
              0,
              0
            ],
            "anchorMax": [
              1,
              0
            ],
            "pivot": [
              0,
              0
            ],
            "offset": [
              16,
              8
            ],
            "offsetMax": [
              -16,
              0
            ],
            "height": 40
          }
        ]
      },
      "expect": {
        "band": [
          16,
          8,
          768,
          40
        ]
      }
