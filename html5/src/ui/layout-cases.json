    {
      "name": "a scroll region measures its children unbounded and shifts them by the offset",
      "why": "The unbounded axis is positive infinity on both engines, never zero. Zero-as-unbounded is the classic way two layout engines drift while both look right alone.",
      "viewport": [
        800,
        200
      ],
      "tree": {
        "name": "root",
        "layout": "column",
        "scroll": "vertical",
        "scrollOffset": [
          0,
          100
        ],
        "children": [
          {
            "name": "r0",
            "width": 100,
            "height": 60
          },
          {
            "name": "r1",
            "width": 100,
            "height": 60
          },
          {
            "name": "r2",
            "width": 100,
            "height": 60
          },
          {
            "name": "r3",
            "width": 100,
            "height": 60
          },
          {
            "name": "r4",
            "width": 100,
            "height": 60
          }
        ]
      },
      "expect": {
        "r0": [
          0,
          -100,
          100,
          60
        ],
        "r2": [
          0,
          20,
          100,
          60
        ],
        "r4": [
          0,
          140,
          100,
          60
        ]
      }
    },
