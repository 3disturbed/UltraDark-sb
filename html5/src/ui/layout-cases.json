{
  "$comment": "Golden layout cases, read by BOTH engines: SexyBiscuit.Tests/UiLayoutTests.cs and html5/tests/uiLayout.test.js. Two independent layout implementations agree only where something forces them to, and reading each other's source with a regex cannot see a numeric disagreement. Every case is pure geometry with fixed sizes -- text measurement is pinned separately by the glyph-table tests, and mixing it in here would make a font change look like a layout bug. Expected rectangles are [x, y, width, height] in canvas units.",
  "version": 1,
  "cases": [
    {
      "name": "a named anchor hangs the node's own matching corner there",
      "why": "The flat script UI has always meant both things by 'anchor', and hud-kit, draft-picker and screen-effects all depend on it. These three numbers are the compatibility contract.",
      "viewport": [
        800,
        600
      ],
      "tree": {
        "name": "root",
        "children": [
          {
            "name": "tl",
            "absolute": true,
            "anchor": "topleft",
            "x": 12,
            "y": 12,
            "width": 268,
            "height": 96
          },
          {
            "name": "c",
            "absolute": true,
            "anchor": "center",
            "x": 0,
            "y": 0,
            "width": 200,
            "height": 44
          },
          {
            "name": "br",
            "absolute": true,
            "anchor": "bottomright",
            "x": -12,
            "y": -12,
            "width": 100,
            "height": 30
          }
        ]
      },
      "expect": {
        "tl": [
          12,
          12,
          268,
          96
        ],
        "c": [
          300,
          278,
          200,
          44
        ],
        "br": [
          688,
          558,
          100,
          30
        ]
      }
    },
    {
