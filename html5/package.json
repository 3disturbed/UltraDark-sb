{
  "name": "sexybiscuit-html5",
  "version": "1.0.0",
  "description": "HTML5/WebGL port of the SexyBiscuit engine, with a JavaScript API mirroring the C# one and direct import of shared project files.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./editor": "./editor/Editor.js",
    "./runtime": "./runtime/Runtime.js"
  },
  "files": ["src", "editor", "runtime", "README.md"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "node tools/serve.js",
    "lint": "node tools/check.js"
  },
  "engines": { "node": ">=18" },
  "keywords": ["game-engine", "webgl", "html5", "sexybiscuit"],
  "license": "MIT",
  "sideEffects": ["./src/**/*.js"]
}
